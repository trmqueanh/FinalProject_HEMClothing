NODE_ENV=development
PORT=3000

# PostgreSQL / Neon
DATABASE_URL=postgresql://user:password@host/database
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
PASSWORD_RESET_SECRET=replace-with-a-different-long-random-secret
PASSWORD_RESET_TTL_MS=86400000
AUTH_RATE_LIMIT_MAX=20
PASSWORD_RESET_RATE_LIMIT_MAX=5

# Storefront and API URLs
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_BASE_URL=http://localhost:3000

# Manual VietQR bank transfer
BANK_TRANSFER_BANK_NAME=MB Bank
BANK_TRANSFER_BANK_ID=MB
BANK_TRANSFER_BANK_BIN=970422
BANK_TRANSFER_ACCOUNT_NUMBER=
BANK_TRANSFER_ACCOUNT_HOLDER=
BANK_TRANSFER_PAYMENT_WINDOW_MINUTES=10
BANK_TRANSFER_EXPIRY_POLL_MS=15000

# Transactional email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=HEM Customer Care <no-reply@example.com>
ADMIN_NOTIFICATION_EMAILS=

# Development only. Never expose reset links in production responses.
EXPOSE_EMAIL_PREVIEWS=true
