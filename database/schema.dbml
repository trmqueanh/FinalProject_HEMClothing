Table "vouchers" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "code" "character varying(100)" [unique, not null]
  "discount_type" "character varying(30)" [not null]
  "discount_value" numeric(12,2) [not null]
  "min_order_amount" numeric(12,2) [default: 0]
  "max_discount_amount" numeric(12,2)
  "start_date" timestamp
  "end_date" timestamp
  "usage_limit" integer
  "used_count" integer [default: 0]
  "status" "character varying(30)" [not null, default: `'active'::charactervarying`]
  "deleted_at" timestamp
  "created_at" timestamp [not null, default: `now()`]
  "updated_at" timestamp [not null, default: `now()`]
  "per_user_limit" integer [default: 1]

  Checks {
    `(end_date > start_date)` [name: 'vouchers_date_range_check']
    `((discount_type)::text = ANY ((ARRAY['percent'::character varying, 'fixed'::character varying])::text[]))` [name: 'vouchers_discount_type_check']
    `(discount_value > (0)::numeric)` [name: 'vouchers_discount_value_check']
    `((max_discount_amount IS NULL) OR (max_discount_amount > (0)::numeric))` [name: 'vouchers_max_discount_amount_check']
    `((min_order_amount IS NULL) OR (min_order_amount >= (0)::numeric))` [name: 'vouchers_min_order_amount_check']
    `((per_user_limit IS NULL) OR (per_user_limit > 0))` [name: 'vouchers_per_user_limit_check']
    `(((discount_type)::text <> 'percent'::text) OR (discount_value <= (100)::numeric))` [name: 'vouchers_percent_value_check']
    `((status)::text = ANY ((ARRAY['active'::character varying, 'inactive'::character varying])::text[]))` [name: 'vouchers_status_check']
    `((usage_limit IS NULL) OR (usage_limit >= 0))` [name: 'vouchers_usage_limit_check']
    `(used_count >= 0)` [name: 'vouchers_used_count_check']
  }

  Indexes {
    deleted_at [type: btree, name: "idx_vouchers_deleted_at"]
    status [type: btree, name: "idx_vouchers_status"]
  }
}

