Table "cart_items" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "cart_id" uuid [not null]
  "product_id" uuid [not null]
  "quantity" integer [not null, default: 1]
  "size_label" "character varying(20)"
  "color_name" "character varying(80)"
  "created_at" timestamp [not null, default: `now()`]
  "updated_at" timestamp [not null, default: `now()`]
  "color_variant_id" uuid

  Checks {
    `(quantity > 0)` [name: 'cart_items_quantity_check']
  }

  Indexes {
    cart_id [type: btree, name: "idx_cart_items_cart_id"]
    color_variant_id [type: btree, name: "idx_cart_items_color_variant_id"]
    product_id [type: btree, name: "idx_cart_items_product_id"]
    (cart_id, product_id, `COALESCE(size_label,''::charactervarying)`, color_variant_id) [type: btree, unique, name: "idx_cart_items_unique_variant"]
  }
}

Table "carts" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "user_id" uuid [unique, not null]
  "created_at" timestamp [not null, default: `now()`]
  "updated_at" timestamp [not null, default: `now()`]
}

Table "categories" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "name" "character varying(100)" [not null]
  "label" "character varying(100)" [not null]
  "created_at" timestamp [default: `now()`]
  "slug" "character varying(120)" [unique]
  "department_id" uuid
  "status" "character varying(30)" [not null, default: `'active'::charactervarying`]
  "updated_at" timestamp [not null, default: `now()`]
  "deleted_at" timestamp
  "product_group_id" uuid

  Indexes {
    deleted_at [type: btree, name: "idx_categories_deleted_at"]
    department_id [type: btree, name: "idx_categories_department_id"]
    status [type: btree, name: "idx_categories_status"]
  }
}

Table "collection_departments" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "collection_id" uuid [not null]
  "department_id" uuid [not null]
  "banner_image_url" text [not null]
  "banner_public_id" text
  "status" "character varying(20)" [not null, default: `'active'::charactervarying`]
  "deleted_at" timestamp
  "created_at" timestamp [not null, default: `now()`]
  "updated_at" timestamp [not null, default: `now()`]

  Checks {
    `((status)::text = ANY ((ARRAY['active'::character varying, 'inactive'::character varying])::text[]))` [name: 'collection_departments_status_check']
  }

  Indexes {
    (collection_id, department_id) [unique, name: "collection_departments_unique"]
    collection_id [type: btree, name: "idx_collection_departments_collection"]
    (department_id, status) [type: btree, name: "idx_collection_departments_department"]
  }
}

Table "collections" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "name" "character varying(120)" [not null]
  "slug" "character varying(140)" [unique, not null]
  "created_at" timestamp [default: `now()`]
  "banner_image" text
  "status" "character varying(30)" [not null, default: `'active'::charactervarying`]
  "deleted_at" timestamp
  "updated_at" timestamp [not null, default: `now()`]

  Indexes {
    deleted_at [type: btree, name: "idx_collections_deleted_at"]
    status [type: btree, name: "idx_collections_status"]
  }
}

Table "currency_conversion_log" {
  "migration_name" "character varying(120)" [pk, not null]
  "converted_at" timestamp [not null, default: `now()`]
}

Table "departments" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "name" "character varying(50)" [unique, not null]
  "label" "character varying(50)" [not null]
  "created_at" timestamp [default: `now()`]
}

Table "fits" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "product_group_id" uuid
  "name" "character varying(80)" [not null]
  "slug" "character varying(100)" [unique, not null]
  "status" "character varying(30)" [not null, default: `'active'::charactervarying`]
  "sort_order" integer [not null, default: 0]
  "created_at" timestamp [default: `now()`]
  "updated_at" timestamp [not null, default: `now()`]
  "deleted_at" timestamp
  "department_id" uuid

  Indexes {
    deleted_at [type: btree, name: "idx_fits_deleted_at"]
    department_id [type: btree, name: "idx_fits_department_id"]
    product_group_id [type: btree, name: "idx_fits_product_group_id"]
    status [type: btree, name: "idx_fits_status"]
  }
}

Table "inventory_logs" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "product_id" uuid [not null]
  "variant_id" uuid
  "type" "character varying(50)" [not null]
  "quantity" integer [not null]
  "note" text
  "created_by" uuid
  "created_at" timestamp [not null, default: `now()`]
  "stock_before" integer
  "stock_after" integer
  "reserved_after" integer [default: 0]
  "sold_after" integer [default: 0]
  "created_by_role" "character varying(20)"

  Checks {
    `((type)::text = ANY ((ARRAY['import'::character varying, 'sold'::character varying, 'sale'::character varying, 'refund'::character varying, 'return'::character varying, 'return_restock'::character varying, 'return_damaged'::character varying, 'delivery_failed_return'::character varying, 'adjustment'::character varying, 'release_hold'::character varying, 'reserve_hold'::character varying, 'cancel'::character varying])::text[]))` [name: 'inventory_logs_type_check']
  }

  Indexes {
    product_id [type: btree, name: "idx_inventory_logs_product_id"]
    variant_id [type: btree, name: "idx_inventory_logs_variant_id"]
  }
}

Table "materials" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "product_group_id" uuid
  "department_id" uuid
  "name" "character varying(120)" [not null]
  "slug" "character varying(180)" [unique, not null]
  "status" "character varying(30)" [not null, default: `'active'::charactervarying`]
  "sort_order" integer [not null, default: 0]
  "created_at" timestamp [default: `now()`]
  "updated_at" timestamp [not null, default: `now()`]
  "deleted_at" timestamp

  Indexes {
    department_id [type: btree, name: "idx_materials_department_id"]
    `lower(TRIM(BOTHFROMname))` [type: btree, name: "idx_materials_name"]
    product_group_id [type: btree, name: "idx_materials_product_group_id"]
    (product_group_id, department_id, status) [type: btree, name: "idx_materials_scope"]
    status [type: btree, name: "idx_materials_status"]
  }
}

Table "order_items" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "order_id" uuid [not null]
  "product_id" uuid [not null]
  "product_name" "character varying(255)" [not null]
  "product_price" numeric(10,2) [not null]
  "quantity" integer [not null, default: 1]
  "size_label" "character varying(20)"
  "color_name" "character varying(80)"
  "created_at" timestamp [not null, default: `now()`]
  "updated_at" timestamp [not null, default: `now()`]
  "product_image" text
  "variant_id" uuid
  "price_at_purchase" numeric(10,2) [not null, default: 0]
  "reserved_quantity" integer [not null, default: 0]
  "original_price_at_purchase" numeric(10,2) [not null, default: 0]
  "pricing_mode_at_purchase" "character varying(30)" [not null, default: `'regular'::charactervarying`]
  "color_variant_id" uuid
  "product_code_at_purchase" "character varying(160)" [note: 'Snapshot of the customer-facing color-level product code at order time.']
  "article_number_at_purchase" "character varying(160)" [note: 'Snapshot of the customer-facing color-level article number at order time.']
  "gross_line_total" numeric(12,2) [not null, default: 0]
  "item_discount_amount" numeric(12,2) [not null, default: 0]
  "voucher_discount_allocated" numeric(12,2) [not null, default: 0]
  "net_line_total" numeric(12,2) [not null, default: 0]
  "refunded_quantity" integer [not null, default: 0]
  "refunded_amount" numeric(12,2) [not null, default: 0]

  Checks {
    `(original_price_at_purchase >= (0)::numeric)` [name: 'order_items_original_price_at_purchase_check']
    `((pricing_mode_at_purchase)::text = ANY ((ARRAY['regular'::character varying, 'sale'::character varying])::text[]))` [name: 'order_items_pricing_mode_at_purchase_check']
    `(product_price >= (0)::numeric)` [name: 'order_items_product_price_check']
    `(quantity > 0)` [name: 'order_items_quantity_check']
    `((gross_line_total >= (0)::numeric) AND (item_discount_amount >= (0)::numeric) AND (voucher_discount_allocated >= (0)::numeric) AND (net_line_total >= (0)::numeric) AND ((net_line_total + voucher_discount_allocated) = gross_line_total))` [name: 'order_items_refund_allocation_check']
    `((refunded_amount >= (0)::numeric) AND (refunded_amount <= net_line_total))` [name: 'order_items_refunded_amount_check']
    `((refunded_quantity >= 0) AND (refunded_quantity <= quantity))` [name: 'order_items_refunded_quantity_check']
  }

  Indexes {
    color_variant_id [type: btree, name: "idx_order_items_color_variant_id"]
    (product_id, product_name) [type: btree, name: "idx_order_items_completed_product_lookup"]
    (order_id, created_at, id) [type: btree, name: "idx_order_items_order_created_id"]
    order_id [type: btree, name: "idx_order_items_order_id"]
    product_code_at_purchase [type: btree, name: "idx_order_items_product_code_at_purchase"]
    product_id [type: btree, name: "idx_order_items_product_id"]
    variant_id [type: btree, name: "idx_order_items_variant_id"]
  }
}

Table "order_status_history" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "order_id" uuid [not null]
  "old_status" "character varying(30)"
  "new_status" "character varying(30)" [not null]
  "changed_by" uuid
  "note" text
  "created_at" timestamp [not null, default: `now()`]
  "changed_by_role" "character varying(20)"

  Checks {
    `((new_status)::text = ANY ((ARRAY['pending'::character varying, 'confirmed'::character varying, 'processing'::character varying, 'shipping'::character varying, 'delivery_failed'::character varying, 'delivered'::character varying, 'completed'::character varying, 'cancelled'::character varying])::text[]))` [name: 'order_status_history_new_status_check']
    `(((old_status)::text = ANY ((ARRAY['pending'::character varying, 'confirmed'::character varying, 'processing'::character varying, 'shipping'::character varying, 'delivery_failed'::character varying, 'delivered'::character varying, 'completed'::character varying, 'cancelled'::character varying])::text[])) OR (old_status IS NULL))` [name: 'order_status_history_old_status_check']
    `(((changed_by_role)::text = ANY ((ARRAY['admin'::character varying, 'user'::character varying, 'system'::character varying])::text[])) OR (changed_by_role IS NULL))` [name: 'order_status_history_role_check']
  }

  Indexes {
    order_id [type: btree, name: "idx_order_status_history_order"]
    (order_id, created_at, id) [type: btree, name: "idx_order_status_history_order_created_id"]
  }
}

Table "orders" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "user_id" uuid [not null]
  "subtotal" numeric(10,2) [not null, default: 0]
  "shipping_fee" numeric(10,2) [not null, default: 0]
  "total_amount" numeric(10,2) [not null, default: 0]
  "payment_method" "character varying(20)" [not null]
  "payment_status" "character varying(20)" [not null, default: `'pending_payment'::charactervarying`]
  "order_status" "character varying(20)" [not null, default: `'pending'::charactervarying`]
  "shipping_full_name" "chot null, default: `''::text`]
  "shipping_note" text
  "cancel_reason" text
  "cancelled_by" "character varying(20)"
  "cancelled_at" timestamparacter varying(120)" [not null]
  "shipping_phone" "character varying(30)" [not null]
  "created_at" timestamp [not null, default: `now()`]
  "updated_at" timestamp [not null, default: `now()`]
  "shipping_city" "character varying(100)" [not null, default: `''::charactervarying`]
  "shipping_district" "character varying(100)" [not null, default: `''::charactervarying`]
  "shipping_ward" "character varying(100)" [not null, default: `''::charactervarying`]
  "shipping_address_line" text [n
  "completed_at" timestamp
  "refunded_at" timestamp
  "voucher_code" "character varying(100)"
  "discount_amount" numeric(10,2) [not null, default: 0]
  "refund_amount" numeric(10,2)
  "refund_method" "character varying(20)"
  "returned_to_warehouse_at" timestamp
  "payment_expires_at" timestamp
  "payment_reported_at" timestamp
  "payment_reviewed_at" timestamp
  "payment_reviewed_by" uuid
  "payment_review_reason" text
  "payment_received_amount" numeric(12,2)
  "delivered_at" timestamp
  "payment_activated_at" timestamp

  Checks {
    `(((cancelled_by)::text = ANY ((ARRAY['user'::character varying, 'admin'::character varying, 'system'::character varying])::text[])) OR (cancelled_by IS NULL))` [name: 'orders_cancelled_by_check']
    `((discount_amount >= (0)::numeric) AND (discount_amount <= subtotal))` [name: 'orders_discount_amount_check']
    `((order_status)::text = ANY ((ARRAY['pending'::character varying, 'confirmed'::character varying, 'processing'::character varying, 'shipping'::character varying, 'delivery_failed'::character varying, 'delivered'::character varying, 'completed'::character varying, 'cancelled'::character varying])::text[]))` [name: 'orders_order_status_check']
    `((payment_method)::text = ANY ((ARRAY['cod'::character varying, 'bank_transfer'::character varying])::text[]))` [name: 'orders_payment_method_check']
    `((payment_received_amount IS NULL) OR (payment_received_amount >= (0)::numeric))` [name: 'orders_payment_received_amount_check']
    `((payment_status)::text = ANY ((ARRAY['pending_payment'::character varying, 'payment_under_review'::character varying, 'paid'::character varying, 'payment_expired'::character varying, 'refund_pending'::character varying, 'partially_refunded'::character varying, 'refunded'::character varying])::text[]))` [name: 'orders_payment_status_check']
    `((refund_amount IS NULL) OR (refund_amount >= (0)::numeric))` [name: 'orders_refund_amount_check']
    `(((refund_method)::text = 'manual'::text) OR (refund_method IS NULL))` [name: 'orders_refund_method_check']
    `(shipping_fee >= (0)::numeric)` [name: 'orders_shipping_fee_check']
    `(subtotal >= (0)::numeric)` [name: 'orders_subtotal_check']
    `(total_amount >= (0)::numeric)` [name: 'orders_total_amount_check']
  }

  Indexes {
    payment_expires_at [type: btree, name: "idx_orders_bank_transfer_expiry"]
    (payment_method, payment_status) [type: btree, name: "idx_orders_bank_transfer_review"]
    cancelled_at [type: btree, name: "idx_orders_cancelled_at"]
    completed_at [type: btree, name: "idx_orders_completed_at"]
    created_at [type: btree, name: "idx_orders_created_at"]
    delivered_at [type: btree, name: "idx_orders_delivered_at"]
    payment_method [type: btree, name: "idx_orders_payment_method"]
    payment_reviewed_by [type: btree, name: "idx_orders_payment_reviewed_by"]
    payment_status [type: btree, name: "idx_orders_payment_status"]
    (payment_status, created_at, id) [type: btree, name: "idx_orders_payment_status_created_id"]
    refunded_at [type: btree, name: "idx_orders_refunded_at"]
    returned_to_warehouse_at [type: btree, name: "idx_orders_returned_to_warehouse_at"]
    order_status [type: btree, name: "idx_orders_status"]
    (order_status, created_at, id) [type: btree, name: "idx_orders_status_created_id"]
    (user_id, created_at, id) [type: btree, name: "idx_orders_user_created_id"]
    user_id [type: btree, name: "idx_orders_user_id"]
    (user_id, shipping_phone, created_at) [type: btree, name: "idx_orders_user_phone_created_at"]
  }
}

Table "product_color_variants" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "product_id" uuid [not null]
  "color_name" "character varying(100)" [not null]
  "color_hex" "character varying(20)"
  "product_code" "character varying(160)" [note: 'Customer-facing color-level product code/article number shown on product, cart, checkout, and order screens.']
  "sort_order" integer [not null, default: 0]
  "created_at" timestamp [default: `CURRENT_TIMESTAMP`]
  "updated_at" timestamp [default: `CURRENT_TIMESTAMP`]
  "deleted_at" timestamp
  "color_family" "character varying(40)" [note: 'Customer-friendly color family used for storefront color filters while preserving exact color_name.']
  "sale_price" numeric(10,2)

  Checks {
    `((color_family IS NULL) OR ((color_family)::text = ANY ((ARRAY['Black'::character varying, 'White'::character varying, 'Gray'::character varying, 'Beige'::character varying, 'Brown'::character varying, 'Red'::character varying, 'Pink'::character varying, 'Purple'::character varying, 'Blue'::character varying, 'Green'::character varying, 'Yellow'::character varying, 'Orange'::character varying, 'Multi'::character varying])::text[])))` [name: 'chk_product_color_variants_color_family_allowed']
    `((color_name IS NOT NULL) AND (length(TRIM(BOTH FROM color_name)) > 0))` [name: 'chk_product_color_variants_color_name_not_blank']
    `((sale_price IS NULL) OR (sale_price >= (0)::numeric))` [name: 'chk_product_color_variants_sale_price_non_negative']
    `(sort_order >= 0)` [name: 'chk_product_color_variants_sort_order_non_negative']
  }

  Indexes {
    color_family [type: btree, name: "idx_product_color_variants_color_family"]
    `lower(TRIM(BOTHFROMproduct_code))` [type: btree, unique, name: "idx_product_color_variants_product_code_active"]
    (product_id, `lower(TRIM(BOTHFROMcolor_name))`) [type: btree, unique, name: "idx_product_color_variants_product_color_active"]
    product_id [type: btree, name: "idx_product_color_variants_product_id"]
    sale_price [type: btree, name: "idx_product_color_variants_sale_price_active"]
  }
  Note: 'Customer-facing color variants. Each product color has its own product code/article number; sizes remain inventory rows.'
}

Table "product_groups" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "name" "character varying(100)" [not null]
  "label" "character varying(100)" [not null]
  "slug" "character varying(120)" [unique, not null]
  "status" "character varying(30)" [not null, default: `'active'::charactervarying`]
  "sort_order" integer [not null, default: 0]
  "created_at" timestamp [default: `now()`]
  "updated_at" timestamp [not null, default: `now()`]
  "deleted_at" timestamp
}

Table "product_highlights" {
  "id" bigint [pk, not null]
  "product_id" uuid [not null]
  "highlight_text" text [not null]
  "sort_order" integer [not null, default: 0]
  "highlight_type" "character varying(50)" [not null, default: `'material_information'::charactervarying`]
  "title" "character varying(160)"

  Checks {
    `((highlight_type)::text = 'material_information'::text)` [name: 'product_highlights_type_check']
  }

  Indexes {
    product_id [type: btree, unique, name: "idx_product_highlights_one_material_info"]
    product_id [type: btree, name: "idx_product_highlights_product_id"]
    (product_id, highlight_type) [type: btree, name: "idx_product_highlights_product_type"]
  }
}

Table "product_images" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "product_id" uuid [not null]
  "color_name" "character varying(80)"
  "image_url" text [not null]
  "alt_text" "character varying(255)"
  "is_primary" boolean [not null, default: false]
  "sort_order" integer [not null, default: 0]
  "created_at" timestamp [not null, default: `now()`]
  "color_variant_id" uuid

  Indexes {
    color_variant_id [type: btree, name: "idx_product_images_color_variant_id"]
    (product_id, color_name) [type: btree, unique, name: "idx_product_images_one_primary_per_color"]
  }
}

Table "product_inventory" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "product_id" uuid [not null]
  "color_name" "character varying(80)" [not null]
  "size_label" "character varying(20)" [not null]
  "stock_quantity" integer [not null, default: 0]
  "created_at" timestamp [not null, default: `now()`]
  "color_hex" "character varying(20)"
  "reserved_quantity" integer [not null, default: 0]
  "sold_quantity" integer [not null, default: 0]
  "updated_at" timestamp [not null, default: `now()`]
  "color_variant_id" uuid
  "product_code" "character varying(160)" [note: 'Customer-facing color-level product code duplicated on each size row for the same product color.']
  "article_number" "character varying(160)" [note: 'Optional customer-facing article number, normally same as product_code.']

  Checks {
    `(reserved_quantity >= 0)` [name: 'inventory_reserved_check']
    `(reserved_quantity <= stock_quantity)` [name: 'inventory_reserved_not_over_stock_check']
    `(sold_quantity >= 0)` [name: 'inventory_sold_check']
    `(stock_quantity >= 0)` [name: 'inventory_stock_check']
  }

  Indexes {
    (product_id, color_name, size_label) [unique, name: "unique_product_color_size"]
    `lower(TRIM(BOTHFROMarticle_number))` [type: btree, name: "idx_product_inventory_article_number"]
    (product_id, color_name, size_label) [type: btree, name: "idx_product_inventory_color_size"]
    color_variant_id [type: btree, name: "idx_product_inventory_color_variant_id"]
    `lower(TRIM(BOTHFROMproduct_code))` [type: btree, name: "idx_product_inventory_product_code"]
    product_id [type: btree, name: "idx_product_inventory_product_id"]
  }
}

Table "product_materials" {
  "id" bigint [pk, not null]
  "product_id" uuid [not null]
  "material_name" "character varying(120)" [not null]
  "sort_order" integer [not null, default: 0]
  "part_name" "character varying(80)" [not null, default: `'Main'::charactervarying`]
  "material_percent" numeric(5,2)
  "material_id" uuid

  Checks {
    `((part_name)::text = ANY ((ARRAY['Main'::character varying, 'Shell'::character varying, 'Lining'::character varying, 'Upper'::character varying, 'Sole'::character varying, 'Trim'::character varying, 'Coating'::character varying, 'Base fabric'::character varying, 'Frame'::character varying, 'Temple'::character varying, 'Lens'::character varying])::text[]))` [name: 'product_materials_part_name_check']
    `((material_percent IS NULL) OR ((material_percent >= (0)::numeric) AND (material_percent <= (100)::numeric)))` [name: 'product_materials_percent_check']
  }

  Indexes {
    material_id [type: btree, name: "idx_product_materials_material_id"]
    `lower(TRIM(BOTHFROMmaterial_name))` [type: btree, name: "idx_product_materials_material_name"]
    product_id [type: btree, name: "idx_product_materials_product_id"]
  }
}

Table "product_reviews" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "product_id" uuid [not null]
  "user_id" uuid [not null]
  "rating" integer [not null]
  "comment" text
  "is_approved" boolean [default: true]
  "created_at" timestamp [default: `now()`]
  "order_id" uuid [not null]
  "updated_at" timestamp [default: `now()`]
  "admin_reply" text
  "admin_reply_by" uuid
  "admin_reply_at" timestamp
  "admin_reply_updated_at" timestamp

  Checks {
    `((rating >= 1) AND (rating <= 5))` [name: 'product_reviews_rating_check']
  }

  Indexes {
    (user_id, order_id, product_id) [unique, name: "unique_user_order_product_review"]
    admin_reply_by [type: btree, name: "idx_product_reviews_admin_reply_by"]
    order_id [type: btree, name: "idx_product_reviews_order_id"]
  }
}

Table "products" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "name" "character varying(255)" [not null]
  "original_price" numeric(10,2) [not null, default: 0]
  "rating" numeric(3,2) [not null, default: 0]
  "reviews" integer [not null, default: 0]
  "description" text
  "fit" "character varying(120)"
  "created_at" timestamp [not null, default: `now()`]
  "updated_at" timestamp [not null, default: `now()`]
  "category_id" uuid
  "department_id" uuid
  "slug" "character varying(255)" [unique]
  "status" "character varying(20)" [not null, default: `'active'::charactervarying`]
  "collection_id" uuid
  "sold_count" integer [not null, default: 0]
  "style_id" uuid
  "sale_price" numeric(10,2)
  "is_sale" boolean [not null, default: false]
  "deleted_at" timestamp
  "pricing_mode" "character varying(30)" [not null, default: `'regular'::charactervarying`]
  "price" numeric(10,2) [not null, default: 0]
  "product_group_id" uuid
  "fit_id" uuid
  "heel_height" "character varying(30)"
  "sleeve_length" "character varying(80)"
  "garment_length" "character varying(80)"
  "neckline" "character varying(80)"
  "waist_rise" "character varying(80)"

  Checks {
    `((heel_height IS NULL) OR ((heel_height)::text = ANY ((ARRAY['High heel'::character varying, 'Mid heel'::character varying, 'Low heel'::character varying, 'No heel'::character varying])::text[])))` [name: 'products_heel_height_check']
    `(original_price >= (0)::numeric)` [name: 'products_original_price_check']
    `(price >= (0)::numeric)` [name: 'products_price_check']
    `((pricing_mode)::text = ANY ((ARRAY['regular'::character varying, 'sale'::character varying])::text[]))` [name: 'products_pricing_mode_check']
    `((((pricing_mode)::text = 'regular'::text) AND (price = original_price) AND (sale_price IS NULL) AND (is_sale = false)) OR (((pricing_mode)::text = 'sale'::text) AND (sale_price IS NOT NULL) AND (sale_price < original_price) AND (price = sale_price) AND (is_sale = true)))` [name: 'products_pricing_state_check']
    `((rating >= (0)::numeric) AND (rating <= (5)::numeric))` [name: 'products_rating_check']
    `(reviews >= 0)` [name: 'products_reviews_check']
    `((sale_price IS NULL) OR (sale_price >= (0)::numeric))` [name: 'products_sale_price_check']
    `((status)::text = ANY ((ARRAY['active'::character varying, 'inactive'::character varying])::text[]))` [name: 'products_status_check']
  }

  Indexes {
    created_at [type: btree, name: "idx_products_created_at"]
    deleted_at [type: btree, name: "idx_products_deleted_at"]
    fit_id [type: btree, name: "idx_products_fit_id"]
    pricing_mode [type: btree, name: "idx_products_pricing_mode"]
    sold_count [type: btree, name: "idx_products_sold_count"]
    status [type: btree, name: "idx_products_status"]
  }
}

Table "refunds" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "refund_code" "character varying(40)" [unique, not null]
  "order_id" uuid [not null]
  "user_id" uuid [not null]
  "return_request_id" uuid
  "refund_type" "character varying(30)" [not null]
  "source_key" "character varying(180)" [unique, not null]
  "requested_amount" numeric(12,2) [not null]
  "approved_amount" numeric(12,2)
  "status" "character varying(30)" [not null, default: `'pending'::charactervarying`]
  "reason" text [not null]
  "admin_note" text
  "transaction_reference" "character varying(160)"
  "failure_reason" text
  "created_by" uuid
  "processed_by" uuid
  "processing_at" timestamp
  "completed_at" timestamp
  "failed_at" timestamp
  "cancelled_at" timestamp
  "created_at" timestamp [not null, default: `now()`]
  "updated_at" timestamp [not null, default: `now()`]
  "refund_bank_code" "character varying(30)"
  "refund_bank_name" "character varying(120)"
  "refund_account_number" "character varying(40)"
  "refund_account_holder" "character varying(160)"
  "refund_account_status" "character varying(30)" [not null, default: `'not_provided'::charactervarying`]
  "refund_account_submitted_at" timestamp

  Checks {
    `(((refund_account_status)::text = 'not_provided'::text) OR ((NULLIF(btrim((refund_bank_name)::text), ''::text) IS NOT NULL) AND (NULLIF(btrim((refund_account_number)::text), ''::text) IS NOT NULL) AND (NULLIF(btrim((refund_account_holder)::text), ''::text) IS NOT NULL)))` [name: 'refunds_account_fields_check']
    `((refund_account_status)::text = ANY ((ARRAY['not_provided'::character varying, 'ready'::character varying])::text[]))` [name: 'refunds_account_status_check']
    `((requested_amount > (0)::numeric) AND ((approved_amount IS NULL) OR (approved_amount > (0)::numeric)))` [name: 'refunds_amount_check']
    `((((refund_type)::text = 'product_return'::text) AND (return_request_id IS NOT NULL)) OR ((refund_type)::text <> 'product_return'::text))` [name: 'refunds_return_source_check']
    `((status)::text = ANY ((ARRAY['pending'::character varying, 'processing'::character varying, 'completed'::character varying, 'failed'::character varying, 'cancelled'::character varying])::text[]))` [name: 'refunds_status_check']
    `((refund_type)::text = ANY ((ARRAY['cancellation'::character varying, 'product_return'::character varying, 'admin_adjustment'::character varying])::text[]))` [name: 'refunds_type_check']
  }

  Indexes {
    (refund_account_status, updated_at) [type: btree, name: "idx_refunds_account_status"]
    (order_id, created_at) [type: btree, name: "idx_refunds_order"]
    return_request_id [type: btree, name: "idx_refunds_return_request"]
    (status, created_at) [type: btree, name: "idx_refunds_status"]
    (user_id, created_at) [type: btree, name: "idx_refunds_user"]
  }
}

Table "return_items" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "return_request_id" uuid [not null]
  "order_item_id" uuid [not null]
  "requested_quantity" integer [not null]
  "approved_quantity" integer [not null, default: 0]
  "received_quantity" integer [not null, default: 0]
  "accepted_quantity" integer [not null, default: 0]
  "rejected_quantity" integer [not null, default: 0]
  "reason" "character varying(80)" [not null]
  "customer_note" text
  "evidence_urls" jsonb [not null, default: `'[]'::jsonb`]
  "condition_code" "character varying(60)"
  "inspection_note" text
  "rejection_reason" text
  "restockable" boolean
  "refund_amount" numeric(12,2) [not null, default: 0]
  "inventory_restored_quantity" integer [not null, default: 0]
  "created_at" timestamp [not null, default: `now()`]
  "updated_at" timestamp [not null, default: `now()`]

  Checks {
    `((approved_quantity >= 0) AND (approved_quantity <= requested_quantity) AND (received_quantity >= 0) AND (received_quantity <= approved_quantity) AND (accepted_quantity >= 0) AND (rejected_quantity >= 0) AND ((accepted_quantity + rejected_quantity) <= received_quantity) AND (inventory_restored_quantity >= 0) AND (inventory_restored_quantity <= accepted_quantity))` [name: 'return_items_quantity_progress_check']
    `((reason)::text = ANY ((ARRAY['wrong_size'::character varying, 'not_as_expected'::character varying, 'changed_mind'::character varying, 'defective'::character varying, 'other'::character varying])::text[]))` [name: 'return_items_reason_check']
    `(refund_amount >= (0)::numeric)` [name: 'return_items_refund_amount_check']
    `(requested_quantity > 0)` [name: 'return_items_requested_quantity_check']
  }

  Indexes {
    (return_request_id, order_item_id) [unique, name: "return_items_unique_order_item"]
    order_item_id [type: btree, name: "idx_return_items_order_item"]
    return_request_id [type: btree, name: "idx_return_items_request"]
  }
}

Table "return_requests" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "order_id" uuid [not null]
  "user_id" uuid [not null]
  "reason" "character varying(80)" [not null]
  "note" text
  "return_status" "character varying(30)" [not null, default: `'requested'::charactervarying`]
  "restock" boolean
  "admin_note" text
  "requested_at" timestamp [not null, default: `now()`]
  "approved_at" timestamp
  "rejected_at" timestamp
  "received_at" timestamp
  "completed_at" timestamp
  "created_at" timestamp [not null, default: `now()`]
  "updated_at" timestamp [not null, default: `now()`]
  "return_code" "character varying(40)" [not null]
  "rejection_reason" text
  "approved_by" uuid
  "received_by" uuid
  "inspected_by" uuid
  "inspection_started_at" timestamp
  "inspected_at" timestamp
  "refund_bank_code" "character varying(30)"
  "refund_bank_name" "character varying(120)"
  "refund_account_number" "character varying(40)"
  "refund_account_holder" "character varying(160)"
  "refund_account_status" "character varying(30)" [not null, default: `'not_provided'::charactervarying`]
  "refund_account_submitted_at" timestamp
  "refund_account_verified_at" timestamp
  "refund_account_verified_by" uuid
  "refund_account_rejection_reason" text

  Checks {
    `((reason)::text = ANY ((ARRAY['wrong_size'::character varying, 'not_as_expected'::character varying, 'changed_mind'::character varying, 'defective'::character varying, 'other'::character varying])::text[]))` [name: 'return_requests_reason_check']
    `(((refund_account_status)::text = 'not_provided'::text) OR ((NULLIF(btrim((refund_bank_name)::text), ''::text) IS NOT NULL) AND (NULLIF(btrim((refund_account_number)::text), ''::text) IS NOT NULL) AND (NULLIF(btrim((refund_account_holder)::text), ''::text) IS NOT NULL)))` [name: 'return_requests_refund_account_fields_check']
    `((refund_account_status)::text = ANY ((ARRAY['not_provided'::character varying, 'ready'::character varying])::text[]))` [name: 'return_requests_refund_account_status_check']
    `((return_status)::text = ANY ((ARRAY['requested'::character varying, 'approved'::character varying, 'awaiting_return'::character varying, 'rejected'::character varying, 'received'::character varying, 'inspecting'::character varying, 'inspection_approved'::character varying, 'inspection_rejected'::character varying, 'refund_pending'::character varying, 'completed'::character varying])::text[]))` [name: 'return_requests_status_check']
  }

  Indexes {
    order_id [type: btree, name: "idx_return_requests_order"]
