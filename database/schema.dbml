    requested_at [type: btree, name: "idx_return_requests_requested_at"]
    return_status [type: btree, name: "idx_return_requests_status"]
    user_id [type: btree, name: "idx_return_requests_user"]
    return_code [type: btree, unique, name: "uq_return_requests_return_code"]
  }
}

