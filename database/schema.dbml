    `((card_last4)::text ~ '^[0-9]{0,4}$'::text)` [name: 'user_profiles_card_last4_check']
    `((gender)::text = ANY ((ARRAY['male'::character varying, 'female'::character varying, 'other'::character varying, ''::character varying])::text[]))` [name: 'user_profiles_gender_check']
    `((payment_provider)::text = ANY ((ARRAY['cod'::character varying, 'bank_transfer'::character varying])::text[]))` [name: 'user_profiles_payment_provider_check']
