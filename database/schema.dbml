  "order_subtotal" numeric(12,2) [not null]
  "discount_amount" numeric(12,2) [not null]
  "created_at" timestamp [not null, default: `now()`]

  Checks {
    `((discount_amount >= (0)::numeric) AND (discount_amount <= order_subtotal))` [name: 'voucher_redemptions_discount_check']
    `(order_subtotal >= (0)::numeric)` [name: 'voucher_redemptions_subtotal_check']
  }

  Indexes {
